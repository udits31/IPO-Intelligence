{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "OPENBELL_APP_URL"
        }
      ]
    }
  },
  "daemons": {
    "collector": {
      "root": ".",
      "entrypoint": "Dockerfile.worker",
      "instances": { "bom1": 1 },
      "livenessProbe": {
        "httpGet": { "port": 8080, "path": "/health" },
        "initialDelaySeconds": 120
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": { "service": "frontend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
